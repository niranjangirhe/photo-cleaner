# Copy this file to .env and set the folder with your unzipped Google Takeout.
# Windows example:  PHOTOS=C:/Users/you/Downloads/Takeout
# macOS example:    PHOTOS=/Users/you/Downloads/Takeout
PHOTOS=./input

# Optional: use Ollama running on your computer instead of the Ollama container
# OLLAMA_URL=http://host.docker.internal:11434
