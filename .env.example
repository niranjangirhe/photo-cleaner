# Optional. Without a .env file, Docker uses the "input" folder in this repository:
# just unzip your Google Takeout there.
#
# To use photos kept somewhere else instead, copy this file to .env and set the folder:
# Windows example:  PHOTOS=C:/Users/you/Downloads/Takeout
# macOS example:    PHOTOS=/Users/you/Downloads/Takeout
PHOTOS=./input

# Optional. The first start downloads a 4.5 GB model from Hugging Face. It works without an account;
# with a free account's token (huggingface.co/settings/tokens, "Read" access) it downloads faster.
# HF_TOKEN=hf_your_token_here
